#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>[o]

#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10     if CONFIG_ZMK_POINTING_SMOOTH_SCROLLING=y default 300


&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <150>;
};


/ {

    conditional_layers {
        compatible = "zmk,conditional-layers";
    };

    keymap {
            compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none         &none            &none        &none         &none         &none
&kp ESC       &kp Q            &kp W        &kp E         &kp R         &kp T
&kp TAB       &kp A            &mt LCTRL S  &mt LALT D    &mt LSHFT F   &kp G
&kp LWIN      &kp Z            &kp X        &kp C         &kp V         &kp B
&none         &none            &kp TILDE    &kp MINUS     &none         &tog 5
&none         &mo 1            &mo 2        &kp K_CUT     &kp SPACE     &kp ENTER
            >;
        };
    };
};
