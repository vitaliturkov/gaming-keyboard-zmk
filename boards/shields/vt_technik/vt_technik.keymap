#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>[o]

#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10     if CONFIG_ZMK_POINTING_SMOOTH_SCROLLING=y default 300


&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <400>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <150>;
};


/ {

    conditional_layers {
        compatible = "zmk,conditional-layers";
    };

    keymap {
            compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp I        &kp M         &kp T         &kp SPACE     &kp LSHFT       &kp LCTRL
                &kp ESC      &kp N1        &kp N2        &kp N3        &kp N4          &kp N5
                &tog 1       &kp TAB       &kp Q         &kp W         &kp E           &kp R
                &tog 2       &kp LCTRL     &kp A         &kp S         &kp D           &kp F
                &kp LALT     &kp LSHFT     &kp Y         &kp X         &kp C           &kp V
                &kp F1       &kp F2        &kp F3        &kp F4        &kp F5          &kp F6
            >;
        };
    };

};